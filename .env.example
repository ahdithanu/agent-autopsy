# Copy to .env and fill in. .env is the only gitignored file in this repo.

# LangSmith. Tracing off means every execution records a null trace URL and the
# reason why; findings published without trace links are worth less, so leave it on.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-autopsy

# Model under test. The exact string is recorded on every execution.
PROVIDER=anthropic
MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=

# Execution bounds. PROTOCOL.md section 4. All three are required; the runner
# refuses to start if any is missing. Denominated in tokens, never dollars.
RECURSION_LIMIT=25
TOKEN_CEILING=50000
SPEND_CEILING_TOKENS=1000000
